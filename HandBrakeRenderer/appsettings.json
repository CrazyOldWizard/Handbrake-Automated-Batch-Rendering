{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AppSettings": {
    "EnableStatusLog": false,
    "HandbrakeCLI": "HandBrakeCLI.exe",
    "DeleteOriginalFiles": false,
    "FileTypes": [
      ".mkv",
      ".mp4",
      ".webm",
      ".avi",
      ".mov",
      ".flv",
      ".wmv",
      ".ts",
      ".m4v",
      ".mpg",
      ".mpeg",
      ".vob",
      ".mts",
      ".m2ts"
    ],
    "CopyRenderFileLocal": false,
    "UtilitiesFolder": "utils",
    "InboxFolder": "Inbox",
    "OutboxFolder": "Encoded",
    "OriginalFilesFolder": "OriginalFiles",
    "HTMLStatusDirectory": "StatusDirectory",
    "PollingIntervalSeconds": 1
  }
}
